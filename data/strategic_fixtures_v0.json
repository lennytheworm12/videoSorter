  "principles": [
    {"id": "principle-access-continuity", "title": "Access and continuity are separate resources", "summary": "A champion may successfully start an interaction but still fail if its damage condition requires continued contact. Peel that interrupts continuity can therefore beat access without preventing the first entry.", "concepts": ["access", "continuity", "conversion"], "confidence": 0.9, "provenance_type": "manual_fixture", "scope": "global", "patch_sensitivity": "very_low", "evidence_refs": [{"source_type": "manual_analysis", "source_id": "phase1-principles", "insight_id": "access-continuity"}]},
