    {"id": "principle-held-threat-value", "title": "Held defensive threat can be active pressure", "summary": "Holding a peel spell may produce value by shrinking the opponent's profitable engage region. Spending it for minor value can transfer initiative even before the opponent acts.", "concepts": ["threat_preservation", "initiative", "access"], "confidence": 0.86, "provenance_type": "manual_fixture", "scope": "global", "patch_sensitivity": "very_low", "evidence_refs": [{"source_type": "manual_analysis", "source_id": "phase1-principles", "insight_id": "held-threat"}]},
    {"id": "principle-conditional-commitment", "title": "Conditional access champions should preserve optionality", "summary": "Champions whose strongest state depends on isolation, marks, or cooldown concessions should not force neutral continuously. They should wait for the state transition, then commit disproportionately hard.", "concepts": ["access", "isolation", "local_numbers", "winning_line"], "confidence": 0.82, "provenance_type": "manual_fixture", "scope": "champion_archetype", "patch_sensitivity": "low", "evidence_refs": [{"source_type": "manual_analysis", "source_id": "phase1-principles", "insight_id": "conditional-commitment"}]},
